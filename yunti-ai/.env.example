YUNTI_AI_APP_NAME=yunti-ai
YUNTI_AI_DEBUG=false
YUNTI_AI_API_PREFIX=/api
YUNTI_AI_LLM_DEFAULT_PROVIDER=mock
YUNTI_AI_LLM_DEFAULT_MODEL=
YUNTI_AI_LLM_TIMEOUT=30
YUNTI_AI_LLM_LOG_PAYLOAD=false
YUNTI_AI_QWEN_API_KEY=
YUNTI_AI_QWEN_MODEL=qwen-plus
YUNTI_AI_DEEPSEEK_API_KEY=
YUNTI_AI_DEEPSEEK_MODEL=deepseek-flash
YUNTI_AI_REDIS_URL=redis://localhost:6379/0
YUNTI_AI_KAFKA_BOOTSTRAP=localhost:9092

# 知识库向量化（第 20 篇）：留空则用本地兜底向量（只能字面匹配，建议配上）
# 千问的 OpenAI 兼容接口和 LLM 用同一个 key
YUNTI_AI_EMBEDDING_PROVIDER=qwen
YUNTI_AI_EMBEDDING_API_KEY=
YUNTI_AI_EMBEDDING_MODEL=text-embedding-v3
# 切片参数（字符数 / 重叠字符数）
YUNTI_AI_KB_CHUNK_SIZE=600
YUNTI_AI_KB_CHUNK_OVERLAP=80
# 知识库所在库（留空则从 ai_db 推导成 customer_db）
YUNTI_AI_KB_DATABASE_URL=

# 视觉模型（客户发图时用它做 OCR / 截图判读，默认 qwen-vl-plus；和文本模型共用同一个千问密钥）
# YUNTI_AI_QWEN_VL_MODEL=qwen-vl-plus
# 一条消息最多看几张图 / 单张 data URL 上限（MB）：前端也卡 3 张，别只改一边
YUNTI_AI_VISION_MAX_IMAGES=3
YUNTI_AI_VISION_MAX_IMAGE_MB=6
